<div class="min-h-screen bg-canvas px-4 py-6 print:bg-white print:p-0">
  <div class="mx-auto mb-4 flex max-w-[820px] items-center justify-between print:hidden">
    <p class="text-sm text-muted">{Format.count(length(@notes), "note")} · one per page</p>
    <.button phx-click={JS.dispatch("zippiker:print")} variant="primary" id="print-button">
      <.icon name="hero-printer-micro" /> Print / Save as PDF
    </.button>
  </div>

  <div id="notes" class="space-y-6 print:space-y-0">
    <div
      :for={note <- @notes}
      id={"note-#{note.id}"}
      class="break-after-page last:break-after-auto"
    >
      <%= if @live_action == :deliveries do %>
        <.delivery_paper note={note} id={"dn-paper-#{note.id}"} />
      <% else %>
        <.goods_receipt_paper note={note} id={"grn-paper-#{note.id}"} />
      <% end %>
    </div>
  </div>

  <p :if={@notes == []} class="py-20 text-center text-sm text-muted">Nothing to print.</p>
</div>
