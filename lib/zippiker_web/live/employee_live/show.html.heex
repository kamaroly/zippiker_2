<Layouts.app
  flash={@flash}
  current_user={@current_user}
  current_organization={@current_organization}
  active={:employees}
>
  <.header>
    <:breadcrumb>
      <.link navigate={~p"/hr/employees"} class="hover:text-ink">Employees</.link>
    </:breadcrumb>
    <span class="flex items-center gap-3">
      <.avatar name={@employee.name} />
      {@employee.name}
      <.badge :if={@employee.status == :terminated} color={:slate}>Former employee</.badge>
      <.badge :if={@employee.on_leave_today?} color={:amber}>Away today</.badge>
    </span>
    <:subtitle>
      {@employee.job_title || "No title"}
      <span :if={@employee.department}>· {@employee.department.name}</span>
      · {@employee.employee_number}
    </:subtitle>
    <:actions>
      <.button
        :if={@membership && can_impersonate?(assigns, @membership)}
        href={~p"/workspaces/#{@current_organization.id}/impersonate/#{@membership.user_id}"}
        method="post"
        data-confirm={"Sign in as #{@employee.name}? You'll see exactly what they see until you stop."}
        id="impersonate-employee"
      >
        <.icon name="hero-eye-micro" /> Impersonate
      </.button>
      <.button
        :if={@employee.status == :active}
        navigate={~p"/hr/leave/new?employee_id=#{@employee.id}"}
        id="request-leave-for"
      >
        <.icon name="hero-sun-micro" /> Request leave
      </.button>
      <.button
        :if={can?(assigns, "employees.manage")}
        navigate={~p"/hr/employees/#{@employee}/edit"}
        variant="primary"
        id="edit-employee"
      >
        <.icon name="hero-pencil-square-micro" /> Edit
      </.button>
    </:actions>
  </.header>

  <div class="grid gap-4 lg:grid-cols-[1fr_320px]">
    <div class="space-y-4">
      <.card title="Leave balances" padded={false}>
        <:action>
          <.link
            :if={can?(assigns, "employees.manage")}
            patch={~p"/hr/employees/#{@employee}/adjust-leave"}
            class="text-muted hover:text-ink"
            id="adjust-leave"
          >
            Adjust balance
          </.link>
        </:action>
        <div
          id="leave-balances"
          class="grid gap-px overflow-hidden rounded-b-2xl bg-line sm:grid-cols-3"
        >
          <div :for={balance <- @balances} class="bg-surface px-5 py-4">
            <.leave_type_badge type={balance.leave_type} />
            <p class="tabular mt-2 text-2xl font-semibold tracking-tight text-ink">
              {if balance.left, do: Decimal.normalize(balance.left), else: "∞"}
              <span class="text-sm font-normal text-muted">days left</span>
            </p>
            <p class="mt-0.5 truncate text-xs text-muted">
              {(balance.policy && balance.policy.name) || "Leave type default"}
            </p>
            <p class="mt-0.5 text-xs text-muted">
              <span :if={Decimal.gt?(balance.earned, 0)}>
                {Decimal.normalize(balance.earned)} {if balance.category == :accrual,
                  do: "accrued",
                  else: "added"} ·
              </span>
              <span :if={Decimal.gt?(balance.carried_over, 0)}>
                incl. {Decimal.normalize(balance.carried_over)} carried over ·
              </span>
              {Decimal.normalize(balance.taken)} taken
              <span :if={Decimal.gt?(balance.pending, 0)}>
                · {Decimal.normalize(balance.pending)} pending
              </span>
              <span :if={balance.allowance}>· of {Decimal.normalize(balance.allowance)}</span>
            </p>
          </div>
          <p :if={@balances == []} class="bg-surface px-5 py-4 text-sm text-muted sm:col-span-3">
            No leave available. Admins set this up under People → Leave policies.
          </p>
        </div>
      </.card>

      <.card title="Onboarding & offboarding" padded={false} id="employee-checklists">
        <:action>
          <.link
            :if={can?(assigns, "employees.manage")}
            navigate={~p"/hr/checklists/new?employee_id=#{@employee.id}"}
            class="text-muted hover:text-ink"
          >
            Start checklist
          </.link>
        </:action>
        <ul class="divide-y divide-line px-5 pb-2">
          <li :for={checklist <- @checklists} class="py-2.5">
            <.link
              navigate={~p"/hr/checklists/#{checklist}"}
              class="flex items-center gap-3 hover:opacity-80"
            >
              <.badge color={if(checklist.kind == :onboarding, do: :emerald, else: :orange)}>
                {Format.humanize(checklist.kind)}
              </.badge>
              <span class="min-w-0 flex-1 truncate text-sm text-ink">{checklist.name}</span>
              <span class="tabular text-xs text-muted">
                {checklist.done_count}/{checklist.tasks_count}
                {if checklist.status == :completed, do: "· done", else: ""}
              </span>
            </.link>
          </li>
          <li :if={@checklists == []} class="py-3 text-sm text-muted">No checklists yet.</li>
        </ul>
      </.card>

      <.card title="Leave history" padded={false}>
        <ul id="employee-leave" phx-update="stream" class="divide-y divide-line px-5 pb-2">
          <li id="employee-leave-empty" class="hidden py-4 text-sm text-muted only:block">
            No leave requested yet.
          </li>
          <li
            :for={{id, request} <- @streams.requests}
            id={id}
            class="flex items-center gap-3 py-2.5"
          >
            <.leave_type_badge type={request.leave_type} />
            <span class="min-w-0 flex-1 truncate text-sm text-ink">{period(request)}</span>
            <span class="tabular text-xs text-muted">{Decimal.normalize(request.days)} d</span>
            <.leave_status status={request.status} />
          </li>
        </ul>
      </.card>

      <.card :if={visible?(@employee.salary)} title="Pay & personal" id="employee-private">
        <.list>
          <:item title="Salary">
            <%= if @employee.salary do %>
              {amount(@employee.salary, @current_organization.currency)} per {per(
                @employee.pay_frequency
              )}
            <% else %>
              —
            <% end %>
          </:item>
          <:item title="Date of birth">{Format.date(@employee.date_of_birth)}</:item>
          <:item title="National ID">{@employee.national_id || "—"}</:item>
          <:item title="Emergency contact">
            {@employee.emergency_contact_name || "—"}
            <span :if={@employee.emergency_contact_phone} class="text-muted">
              · {@employee.emergency_contact_phone}
            </span>
          </:item>
        </.list>
      </.card>

      <.card :if={@definitions != []} title="More">
        <.custom_field_values values={@employee.custom_fields} definitions={@definitions} />
      </.card>
    </div>

    <aside class="space-y-4">
      <.card title="Job">
        <.list>
          <:item title="Contract">{Format.humanize(@employee.employment_type)}</:item>
          <:item title="Started">{Format.date(@employee.hire_date)}</:item>
          <:item title="Leave policies">
            <.link navigate={~p"/hr/leave-policies"} class="hover:underline">
              {case @employee.leave_policies do
                [] -> "Defaults"
                policies -> Enum.map_join(policies, ", ", & &1.name)
              end}
            </.link>
          </:item>
          <:item :if={@employee.termination_date} title="Left">
            {Format.date(@employee.termination_date)}
            <span :if={@employee.termination_reason} class="block text-xs text-muted">
              {@employee.termination_reason}
            </span>
          </:item>
          <:item title="Email">{@employee.email || "—"}</:item>
          <:item title="Phone">{@employee.phone || "—"}</:item>
          <:item title="Login">
            {if @employee.user, do: @employee.user.email, else: "Not linked"}
          </:item>
        </.list>
      </.card>

      <.card title="Reporting">
        <p class="text-xs text-muted">Reports to</p>
        <.link
          :if={@employee.manager}
          navigate={~p"/hr/employees/#{@employee.manager}"}
          class="mt-1 flex items-center gap-2 text-sm font-medium text-ink hover:underline"
        >
          <.avatar name={@employee.manager.name} size="xs" /> {@employee.manager.name}
        </.link>
        <p :if={!@employee.manager} class="mt-1 text-sm text-ink-soft">Nobody (top level)</p>

        <p class="mt-4 text-xs text-muted">
          {Format.count(length(@employee.direct_reports), "direct report")}
        </p>
        <ul id="direct-reports" class="mt-1 space-y-1">
          <li :for={report <- @employee.direct_reports} id={"report-#{report.id}"}>
            <.link
              navigate={~p"/hr/employees/#{report}"}
              class="flex items-center gap-2 text-sm text-ink hover:underline"
            >
              <.avatar name={report.name} size="xs" /> {report.name}
            </.link>
          </li>
        </ul>
      </.card>

      <div :if={can?(assigns, "employees.manage")} class="flex flex-col gap-2">
        <.button
          :if={@employee.status == :active}
          patch={~p"/hr/employees/#{@employee}/terminate"}
          variant="danger"
          id="terminate-employee"
        >
          Mark as left
        </.button>
        <.button
          :if={@employee.status == :terminated}
          phx-click="rehire"
          data-confirm="Rehire this person?"
          id="rehire-employee"
        >
          Rehire
        </.button>
      </div>
    </aside>
  </div>

  <.modal
    :if={@terminating?}
    id="terminate-modal"
    show
    title={"#{@employee.name} is leaving"}
    on_cancel={JS.patch(~p"/hr/employees/#{@employee}")}
  >
    <form id="termination-form" phx-submit="terminate" class="space-y-4">
      <.input
        type="date"
        name="termination[termination_date]"
        id="termination-date"
        value={Date.utc_today()}
        label="Last day"
      />
      <.input
        type="textarea"
        name="termination[termination_reason]"
        id="termination-reason"
        value=""
        label="Reason (internal)"
      />
      <p class="text-xs text-muted">
        They stay in the directory under “Former”, with their history.
      </p>
      <div class="flex justify-end">
        <.button type="submit" variant="danger" phx-disable-with="Saving…">Confirm</.button>
      </div>
    </form>
  </.modal>
  <.modal
    :if={@live_action == :adjust_leave}
    id="adjust-leave-modal"
    show
    title={"Adjust #{@employee.name}'s leave"}
    on_cancel={JS.patch(~p"/hr/employees/#{@employee}")}
  >
    <form id="adjust-leave-form" phx-submit="adjust_leave" class="space-y-4">
      <div class="grid gap-4 sm:grid-cols-2">
        <.input
          type="select"
          name="adjust[leave_type_id]"
          id="adjust-type"
          label="Leave type"
          value=""
          options={Enum.map(@balances, &{&1.leave_type.name, &1.leave_type.id})}
        />
        <.input
          type="number"
          step="0.5"
          name="adjust[days]"
          id="adjust-days"
          value=""
          label="Days (+ add, − take away)"
          placeholder="2"
        />
      </div>
      <.input
        type="date"
        name="adjust[effective_on]"
        id="adjust-date"
        value={Date.utc_today()}
        label="Effective on"
      />
      <.input
        name="adjust[note]"
        id="adjust-note"
        value=""
        label="Reason"
        placeholder="Opening balance, correction…"
      />
      <div class="flex justify-end">
        <.button type="submit" variant="primary" phx-disable-with="Saving…">Save</.button>
      </div>
    </form>
    <div :if={@entries != []} class="mt-6 border-t border-line pt-4">
      <p class="mb-2 text-xs font-semibold tracking-wide text-muted uppercase">Recent changes</p>
      <ul id="balance-entries" class="space-y-1.5 text-sm">
        <li :for={entry <- @entries} class="flex items-center gap-2">
          <span class="w-24 shrink-0 text-xs text-muted">{Format.date(entry.effective_on)}</span>
          <span class="min-w-0 flex-1 truncate text-ink-soft">
            {entry.leave_type.name} · {Format.humanize(entry.kind)}
            <span :if={entry.note} class="text-muted">· {entry.note}</span>
          </span>
          <span class={[
            "tabular",
            if(Decimal.negative?(entry.days), do: "text-danger", else: "text-success")
          ]}>
            {if Decimal.negative?(entry.days), do: "", else: "+"}{Decimal.normalize(entry.days)}
          </span>
        </li>
      </ul>
    </div>
  </.modal>
</Layouts.app>
