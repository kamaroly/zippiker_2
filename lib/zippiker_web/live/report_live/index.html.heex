<Layouts.app
  flash={@flash}
  current_user={@current_user}
  current_organization={@current_organization}
  active={:report_center}
>
  <.header>
    Reports
    <:subtitle>
      {length(@reports)} standard reports across your modules, always up to date.
    </:subtitle>
  </.header>

  <form id="report-search" phx-change="search" phx-submit="search" class="mb-6">
    <label class="relative block max-w-xl">
      <.icon
        name="hero-magnifying-glass"
        class="pointer-events-none absolute top-1/2 left-3.5 size-5 -translate-y-1/2 text-muted"
      />
      <input
        type="search"
        name="query"
        id="report-search-input"
        value={@query}
        phx-debounce="150"
        autocomplete="off"
        placeholder="Type a report name, e.g. ageing, VAT, ledger…"
        class="h-11 w-full rounded-xl border border-line bg-surface pr-4 pl-11 text-sm text-ink shadow-card transition placeholder:text-muted focus:border-brand focus:ring-2 focus:ring-brand/20 focus:outline-none"
      />
    </label>
  </form>

  <section :if={@query == "" and @popular != []} id="report-popular" class="mb-8">
    <h2 class="mb-3 text-xs font-semibold tracking-wider text-muted uppercase">Popular</h2>
    <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
      <.link
        :for={report <- @popular}
        navigate={~p"/reports/#{report.key}"}
        id={"popular-#{report.key}"}
        class="group rounded-2xl border border-line bg-surface p-4 shadow-card transition hover:-translate-y-0.5 hover:border-brand/40 hover:shadow-pop"
      >
        <span class="mb-3 flex size-9 items-center justify-center rounded-xl bg-brand/10 text-brand">
          <.icon name="hero-chart-bar" class="size-5" />
        </span>
        <span class="block font-semibold text-ink group-hover:text-brand">{report.title}</span>
        <span class="mt-1 block text-xs leading-relaxed text-muted">{report.description}</span>
      </.link>
    </div>
  </section>

  <div
    :if={@groups == []}
    id="report-no-match"
    class="rounded-2xl border border-dashed border-line px-6 py-12 text-center"
  >
    <p class="font-medium text-ink">No report matches “{@query}”.</p>
    <p class="mt-1 text-sm text-muted">Try “profit”, “ageing”, “VAT” or “inventory”.</p>
  </div>

  <div class="space-y-8">
    <section :for={group <- @groups} id={"report-group-#{group.key}"}>
      <h2 class="mb-3 flex items-center gap-2 text-xs font-semibold tracking-wider text-muted uppercase">
        {group.label}
        <span class="rounded-full bg-canvas px-2 py-0.5 text-[10px] font-medium normal-case">
          {length(group.reports)}
        </span>
      </h2>
      <div class="grid gap-x-6 rounded-2xl border border-line bg-surface p-2 shadow-card md:grid-cols-2 xl:grid-cols-3">
        <.link
          :for={report <- group.reports}
          navigate={~p"/reports/#{report.key}"}
          id={"report-link-#{group.key}-#{report.key}"}
          class="group flex items-start gap-3 rounded-xl px-3 py-2.5 transition hover:bg-canvas"
        >
          <.icon
            name="hero-document-chart-bar"
            class="mt-0.5 size-4 shrink-0 text-muted transition group-hover:text-brand"
          />
          <span class="min-w-0">
            <span class="block text-sm font-medium text-ink group-hover:text-brand">
              {report.title}
            </span>
            <span class="block truncate text-xs text-muted" title={report.description}>
              {report.description}
            </span>
          </span>
          <span class="ml-auto shrink-0 pt-0.5 text-[10px] text-muted opacity-0 transition group-hover:opacity-100">
            {period_label(report.period)}
          </span>
        </.link>
      </div>
    </section>
  </div>
</Layouts.app>
