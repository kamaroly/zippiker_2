<Layouts.app
  flash={@flash}
  current_user={@current_user}
  current_organization={@current_organization}
  active={:production_orders}
>
  <.header>
    <:breadcrumb>
      <.link navigate={~p"/manufacturing/orders"} class="hover:text-ink">Production orders</.link>
    </:breadcrumb>
    <span class="flex items-center gap-3">
      {@order.number} <.production_status status={@order.status} />
    </span>
    <:subtitle>{qty(@order.quantity)} × {@order.product.name}</:subtitle>
    <:actions>
      <.button navigate={~p"/manufacturing/orders/#{@order}/print"} id="print-job-card">
        <.icon name="hero-printer-micro" /> Job card
      </.button>
      <.button
        :if={@order.status in [:draft, :confirmed]}
        patch={~p"/manufacturing/orders/#{@order}/edit"}
        id="edit-production-order"
      >
        <.icon name="hero-pencil-square-micro" /> Edit
      </.button>
      <.button
        :if={@order.status == :draft}
        phx-click="confirm"
        variant="primary"
        id="confirm-production-order"
      >
        <.icon name="hero-check-micro" /> Confirm
      </.button>
      <.button
        :if={@order.status in [:confirmed, :in_progress]}
        patch={~p"/manufacturing/orders/#{@order}/produce"}
        variant="primary"
        id="record-production"
      >
        <.icon name="hero-cube-micro" /> Record output
      </.button>
    </:actions>
  </.header>

  <div class="grid gap-4 lg:grid-cols-[1fr_320px]">
    <div class="space-y-4">
      <.card
        title={
          if(@order.status in [:done, :cancelled],
            do: "Components per #{qty(@order.quantity)} units",
            else: "Components for the remaining #{qty(@planned)}"
          )
        }
        padded={false}
      >
        <table id="requirements" class="w-full text-sm">
          <thead>
            <tr class="border-b border-line text-left text-xs text-muted">
              <th class="px-5 py-2 font-medium">Component</th>
              <th class="px-3 py-2 text-right font-medium">Needed</th>
              <th class="px-3 py-2 text-right font-medium">In stock</th>
              <th class="px-5 py-2 text-right font-medium">Cost</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            <tr :for={row <- @requirements} id={"requirement-#{row.product.id}"}>
              <td class="px-5 py-2.5">
                <.link
                  navigate={~p"/inventory/products/#{row.product}"}
                  class="text-ink hover:underline"
                >
                  {row.product.name}
                </.link>
                <span
                  :if={Decimal.gt?(row.shortage, 0) and @order.status not in [:done, :cancelled]}
                  class="ml-2"
                >
                  <.badge color={:rose}>Short {qty(row.shortage)}</.badge>
                </span>
              </td>
              <td class="tabular px-3 py-2.5 text-right text-ink">
                {qty(row.required)} {row.product.unit}
              </td>
              <td class={[
                "tabular px-3 py-2.5 text-right",
                if(Decimal.gt?(row.shortage, 0), do: "text-danger", else: "text-muted")
              ]}>
                {qty(row.on_hand)}
              </td>
              <td class="tabular px-5 py-2.5 text-right text-ink">
                {money(row.cost, @currency)}
              </td>
            </tr>
          </tbody>
        </table>
      </.card>

      <.card :if={@operations != []} title="Operations" padded={false}>
        <ul id="operations" class="divide-y divide-line px-5 pb-2">
          <li :for={row <- @operations} class="flex items-center gap-3 py-2.5 text-sm">
            <.icon name="hero-cog-6-tooth" class="size-4 text-muted" />
            <div class="min-w-0 flex-1">
              <p class="truncate text-ink">{row.operation.name}</p>
              <p class="text-xs text-muted">{row.operation.work_center.name}</p>
            </div>
            <span class="tabular text-muted">{duration(row.minutes)}</span>
            <span class="tabular w-24 text-right text-ink">{money(row.cost, @currency)}</span>
          </li>
        </ul>
      </.card>

      <.card title="Production runs" padded={false}>
        <ul id="production-runs" class="divide-y divide-line px-5 pb-2">
          <li
            :for={run <- @runs}
            id={"run-#{run.id}"}
            class="flex items-center gap-3 py-2.5 text-sm"
          >
            <.link
              navigate={~p"/inventory/operations/#{run}"}
              class="min-w-0 flex-1 hover:opacity-80"
            >
              <span class="font-medium text-ink">{run.number}</span>
              <span class="block truncate text-xs text-muted">
                {Format.date(run.date)} · {run.memo}
              </span>
            </.link>
            <span class="tabular text-ink">{money(run.total_value, @currency)}</span>
          </li>
          <li :if={@runs == []} class="py-3 text-sm text-muted">
            Nothing produced yet. Each time you record output, the components used and the finished
            goods are moved in stock.
          </li>
        </ul>
      </.card>
    </div>

    <aside class="space-y-4">
      <.card title="Progress">
        <.production_progress order={@order} />
        <dl class="mt-4 space-y-2 text-sm">
          <div class="flex justify-between">
            <dt class="text-muted">Produced so far</dt>
            <dd class="tabular text-ink">{qty(@order.produced_quantity)}</dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-muted">Actual cost</dt>
            <dd class="tabular text-ink">{money(@order.actual_cost, @currency)}</dd>
          </div>
        </dl>
      </.card>

      <.card
        :if={@order.status not in [:done, :cancelled]}
        title={"Estimate for #{qty(@planned)}"}
      >
        <dl id="estimate" class="space-y-2 text-sm">
          <div class="flex justify-between">
            <dt class="text-muted">Materials</dt>
            <dd class="tabular text-ink">{money(@estimate.materials, @currency)}</dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-muted">Labour &amp; overhead</dt>
            <dd class="tabular text-ink">{money(@estimate.labour, @currency)}</dd>
          </div>
          <div class="flex justify-between border-t border-line pt-2 font-semibold">
            <dt class="text-ink">Total</dt>
            <dd class="tabular text-ink">{money(@estimate.total, @currency)}</dd>
          </div>
          <div class="flex justify-between text-xs">
            <dt class="text-muted">Per unit</dt>
            <dd class="tabular text-muted">
              {money(Decimal.round(@estimate.unit_cost, 2), @currency)}
            </dd>
          </div>
        </dl>
      </.card>

      <.card title="Details">
        <.list>
          <:item title="Product">
            <.link navigate={~p"/inventory/products/#{@order.product}"} class="hover:underline">
              {@order.product.name}
            </.link>
          </:item>
          <:item title="Bill of materials">
            <.link navigate={~p"/manufacturing/boms/#{@order.bom}/edit"} class="hover:underline">
              {@order.bom.reference}
            </.link>
          </:item>
          <:item title="Warehouse">
            {(@order.warehouse && @order.warehouse.name) || "Default"}
          </:item>
          <:item title="Start">{Format.date(@order.planned_start)}</:item>
          <:item :if={@order.due_on} title="Due">{Format.date(@order.due_on)}</:item>
          <:item title="Responsible">{Format.user_name(@order.owner)}</:item>
          <:item :if={@order.finished_at} title="Finished">
            {Format.date(@order.finished_at)}
          </:item>
        </.list>
        <p :if={@order.notes} class="mt-3 text-sm whitespace-pre-line text-ink-soft">
          {@order.notes}
        </p>
      </.card>

      <.button
        :if={@order.status == :in_progress}
        phx-click="finish"
        data-confirm="Close this order? The rest won't be produced."
        class="w-full"
        id="finish-production-order"
      >
        Close order early
      </.button>
      <.button
        :if={@order.status in [:draft, :confirmed]}
        phx-click="cancel"
        data-confirm="Cancel this production order?"
        variant="danger"
        class="w-full"
        id="cancel-production-order"
      >
        Cancel order
      </.button>
    </aside>
  </div>

  <.modal
    :if={@live_action == :produce}
    id="produce-modal"
    show
    title="Record output"
    on_cancel={JS.patch(~p"/manufacturing/orders/#{@order}")}
  >
    <form id="produce-form" phx-submit="produce" class="space-y-4">
      <p class="text-sm text-muted">
        How many {@order.product.name} were finished? Their components are taken out of stock and
        the finished units come in at cost.
      </p>
      <div class="grid gap-4 sm:grid-cols-2">
        <.input
          type="number"
          step="any"
          min="0"
          name="produce[quantity]"
          id="produce-quantity"
          value={qty(@order.remaining_quantity)}
          label="Quantity produced"
        />
        <.input
          type="date"
          name="produce[date]"
          id="produce-date"
          value={Date.utc_today()}
          label="Date"
        />
      </div>
      <div class="flex justify-end">
        <.button type="submit" variant="primary" phx-disable-with="Recording…">Record</.button>
      </div>
    </form>
  </.modal>

  <.modal
    :if={@form}
    id="edit-production-modal"
    show
    title={"Edit #{@order.number}"}
    on_cancel={JS.patch(~p"/manufacturing/orders/#{@order}")}
  >
    <.form
      for={@form}
      id="edit-production-form"
      phx-change="validate"
      phx-submit="save"
      class="space-y-4"
    >
      <div class="grid gap-4 sm:grid-cols-2">
        <.input field={@form[:quantity]} type="number" step="any" min="0" label="Quantity" />
        <.input
          field={@form[:bom_id]}
          type="select"
          label="Bill of materials"
          options={Enum.map(@boms, &{&1.reference, &1.id})}
        />
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        <.input field={@form[:planned_start]} type="date" label="Start" />
        <.input field={@form[:due_on]} type="date" label="Due" />
        <.input
          field={@form[:warehouse_id]}
          type="select"
          label="Warehouse"
          prompt="Default"
          options={Enum.map(@warehouses, &{&1.name, &1.id})}
        />
      </div>
      <.input field={@form[:notes]} type="textarea" label="Notes" rows="2" />
      <div class="flex justify-end">
        <.button type="submit" variant="primary" phx-disable-with="Saving…">Save</.button>
      </div>
    </.form>
  </.modal>
</Layouts.app>
