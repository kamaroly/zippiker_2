<Layouts.app
  flash={@flash}
  current_user={@current_user}
  current_organization={@current_organization}
  active={:approval_workflows}
>
  <.header>
    Approval workflows
    <:subtitle>
      Who approves each kind of document, in order. The last approver gives the final sign-off.
    </:subtitle>
    <:actions>
      <.button
        :if={can?(assigns, "approvals.setup")}
        patch={~p"/approvals/workflows/new"}
        variant="primary"
        id="new-workflow"
      >
        <.icon name="hero-plus-micro" /> Workflow
      </.button>
    </:actions>
  </.header>

  <div id="workflows" class="space-y-8">
    <section
      :for={type <- @document_types}
      id={"workflows-#{type.key}"}
      class="space-y-3"
    >
      <h2 class="flex items-center gap-2 text-sm font-semibold text-ink">
        {type.label}
        <span class="text-xs font-normal text-muted">
          · {ZippikerWeb.Modules.name(type.module)} module
        </span>
      </h2>
      <p
        :if={workflows_for(@workflows, type.key) == []}
        class="rounded-2xl border border-dashed border-line px-4 py-5 text-sm text-muted"
      >
        No workflow yet: any workspace admin approves {String.downcase(type.label)}.
      </p>
      <.card :for={workflow <- workflows_for(@workflows, type.key)} id={"workflow-#{workflow.id}"}>
        <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
          <div>
            <h2 class="flex items-center gap-2 text-base font-semibold text-ink">
              {workflow.name}
              <.badge :if={!workflow.active?}>Inactive</.badge>
            </h2>
            <p class="text-xs text-muted">{threshold(workflow, @currency)}</p>
          </div>
          <span :if={can?(assigns, "approvals.setup")} class="flex gap-3 text-sm">
            <.link
              patch={~p"/approvals/workflows/#{workflow}/edit"}
              class="text-ink-soft hover:text-ink"
              id={"edit-workflow-#{workflow.id}"}
            >
              Edit
            </.link>
            <.link
              phx-click="delete"
              phx-value-id={workflow.id}
              data-confirm={"Delete #{workflow.name}?"}
              class="text-danger hover:opacity-80"
            >
              Delete
            </.link>
          </span>
        </div>
        <ol class="flex flex-wrap items-center gap-2">
          <li class="flex items-center gap-2">
            <span class="rounded-xl border border-dashed border-line px-3 py-2 text-sm text-muted">
              <.icon name="hero-user-micro" /> Initiator
            </span>
          </li>
          <li :for={step <- workflow.steps} class="flex items-center gap-2">
            <.icon name="hero-arrow-long-right" class="size-5 text-muted" />
            <span class={[
              "rounded-xl border px-3 py-2 text-sm shadow-card",
              if(step.position == length(workflow.steps),
                do: "border-ink bg-ink text-surface",
                else: "border-line bg-surface text-ink"
              )
            ]}>
              <span class="block text-[10px] font-semibold tracking-wide uppercase opacity-60">
                {if step.position == length(workflow.steps),
                  do: "Final approver",
                  else: "Approver #{step.position}"}
              </span>
              {step.label || approver_label(step)}
              <span :if={step.label} class="block text-xs opacity-70">{approver_label(step)}</span>
            </span>
          </li>
        </ol>
      </.card>
    </section>
  </div>

  <.modal
    :if={@editing?}
    id="workflow-modal"
    show
    title={if(@workflow, do: "Edit #{@workflow.name}", else: "New approval workflow")}
    on_cancel={JS.patch(~p"/approvals/workflows")}
  >
    <form id="workflow-form" phx-change="change" phx-submit="save" class="space-y-5">
      <.input
        :if={!@workflow}
        type="select"
        name="workflow[document_type]"
        id="workflow-document-type"
        value={@fields["document_type"]}
        label="Approves"
        options={Enum.map(@document_types, &{&1.label, &1.key})}
      />
      <div class="grid gap-4 sm:grid-cols-[1fr_12rem]">
        <.input
          name="workflow[name]"
          id="workflow-name"
          value={@fields["name"]}
          label="Name"
          required
        />
        <.input
          type="number"
          step="0.01"
          min="0"
          name="workflow[min_amount]"
          id="workflow-min-amount"
          value={@fields["min_amount"]}
          label={amount_label(@fields["document_type"], @currency)}
        />
      </div>

      <div>
        <p class="mb-2 text-sm font-medium text-ink">Approvers, in order</p>
        <ol id="workflow-steps" class="space-y-2">
          <li
            :for={{step, index} <- Enum.with_index(@steps)}
            id={"step-#{step["key"]}"}
            class="rounded-xl border border-line bg-canvas/50 p-3"
          >
            <div class="mb-2 flex items-center justify-between">
              <span class="text-xs font-semibold tracking-wide text-muted uppercase">
                {if index == length(@steps) - 1,
                  do: "Final approver",
                  else: "Approver #{index + 1}"}
              </span>
              <span class="flex items-center gap-1">
                <button
                  type="button"
                  phx-click="move_step"
                  phx-value-key={step["key"]}
                  phx-value-by="-1"
                  disabled={index == 0}
                  class="rounded p-1 text-muted hover:bg-surface hover:text-ink disabled:opacity-30"
                  title="Move up"
                >
                  <.icon name="hero-arrow-up-micro" />
                </button>
                <button
                  type="button"
                  phx-click="move_step"
                  phx-value-key={step["key"]}
                  phx-value-by="1"
                  disabled={index == length(@steps) - 1}
                  class="rounded p-1 text-muted hover:bg-surface hover:text-ink disabled:opacity-30"
                  title="Move down"
                >
                  <.icon name="hero-arrow-down-micro" />
                </button>
                <button
                  type="button"
                  phx-click="remove_step"
                  phx-value-key={step["key"]}
                  class="rounded p-1 text-muted hover:bg-danger-soft hover:text-danger"
                  title="Remove"
                  id={"remove-step-#{step["key"]}"}
                >
                  <.icon name="hero-trash-micro" />
                </button>
              </span>
            </div>
            <div class="grid gap-3 sm:grid-cols-3">
              <.input
                type="select"
                name={"steps[#{step["key"]}][approver_type]"}
                id={"step-type-#{step["key"]}"}
                value={step["approver_type"]}
                options={@types}
              />
              <.input
                :if={step["approver_type"] == "user"}
                type="select"
                name={"steps[#{step["key"]}][user_id]"}
                id={"step-user-#{step["key"]}"}
                value={step["user_id"]}
                prompt="Choose a person"
                options={@members}
              />
              <.input
                :if={step["approver_type"] == "group"}
                type="select"
                name={"steps[#{step["key"]}][group_id]"}
                id={"step-group-#{step["key"]}"}
                value={step["group_id"]}
                prompt="Choose a group"
                options={Enum.map(@groups, &{&1.name, &1.id})}
              />
              <div :if={step["approver_type"] in ["manager", "admins"]} />
              <.input
                name={"steps[#{step["key"]}][label]"}
                id={"step-label-#{step["key"]}"}
                value={step["label"]}
                placeholder="Label, e.g. Finance"
              />
            </div>
          </li>
        </ol>
        <button
          type="button"
          phx-click="add_step"
          id="add-step"
          class="mt-2 inline-flex items-center gap-1 text-sm font-medium text-ink-soft hover:text-ink"
        >
          <.icon name="hero-plus-micro" /> Add approver
        </button>
        <p :if={@groups == []} class="mt-2 text-xs text-muted">
          Tip: create
          <.link navigate={~p"/approvals/groups"} class="underline">approval groups</.link>
          to let any member of a team approve a step.
        </p>
      </div>

      <label class="flex items-center gap-2 text-sm text-ink">
        <input type="hidden" name="workflow[active?]" value="false" />
        <input
          type="checkbox"
          name="workflow[active?]"
          value="true"
          id="workflow-active"
          checked={@fields["active?"] == "true"}
          class="size-4 rounded border-line"
        /> Active
      </label>
      <p class="text-xs text-muted">
        Nobody approves their own claim: a step whose only approver is the initiator (or with
        nobody to ask, like a manager who isn't set) is skipped.
      </p>
      <div class="flex justify-end">
        <.button type="submit" variant="primary" phx-disable-with="Saving…" id="save-workflow">
          Save workflow
        </.button>
      </div>
    </form>
  </.modal>
</Layouts.app>
