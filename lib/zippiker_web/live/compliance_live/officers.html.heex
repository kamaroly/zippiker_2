<Layouts.app
  flash={@flash}
  current_user={@current_user}
  current_organization={@current_organization}
  active={:compliance_officers}
>
  <.header>
    Directors &amp; secretaries
    <:subtitle>
      The register of directors and the register of secretaries, with residential addresses.
    </:subtitle>
    <:actions>
      <.button :if={@profile} navigate={~p"/compliance/print/officers"} id="print-officers">
        <.icon name="hero-printer-micro" /> Print register
      </.button>
      <.button
        :if={@profile && can?(assigns, "compliance.manage")}
        patch={~p"/compliance/officers?modal=appoint"}
        variant="primary"
        id="appoint-officer"
      >
        <.icon name="hero-plus-micro" /> Appoint
      </.button>
    </:actions>
  </.header>

  <%= if @profile do %>
    <.card padded={false}>
      <table id="officers" class="w-full text-sm">
        <thead>
          <tr class="border-b border-line text-left text-xs text-muted">
            <th class="px-5 py-2 font-medium">Name</th>
            <th class="px-3 py-2 font-medium">Role</th>
            <th class="hidden px-3 py-2 font-medium md:table-cell">ID / KRA PIN</th>
            <th class="px-3 py-2 font-medium">Appointed</th>
            <th class="px-3 py-2 font-medium">Ceased</th>
            <th class="px-5 py-2"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          <tr
            :for={officer <- @officers}
            id={"officer-#{officer.id}"}
            class={!officer.active? && "text-muted"}
          >
            <td class="px-5 py-2.5">
              <span class="font-medium text-ink">{officer.name}</span>
              <span :if={officer.nationality} class="block text-xs text-muted">{officer.nationality}</span>
            </td>
            <td class="px-3 py-2.5">{officer_role_label(officer.role)}</td>
            <td class="hidden px-3 py-2.5 md:table-cell">
              {officer.id_number || "—"}<span :if={officer.kra_pin}> · {officer.kra_pin}</span>
            </td>
            <td class="px-3 py-2.5">{Format.date(officer.appointed_on)}</td>
            <td class="px-3 py-2.5">{Format.date(officer.ceased_on)}</td>
            <td class="px-5 py-2.5 text-right">
              <span :if={can?(assigns, "compliance.manage")} class="flex justify-end gap-3">
                <.link
                  patch={~p"/compliance/officers?modal=edit&id=#{officer.id}"}
                  class="text-ink-soft hover:text-ink"
                >Edit</.link>
                <.link
                  :if={officer.active?}
                  patch={~p"/compliance/officers?modal=cease&id=#{officer.id}"}
                  class="text-danger hover:opacity-80"
                  id={"cease-#{officer.id}"}
                >
                  Cease
                </.link>
              </span>
            </td>
          </tr>
          <tr :if={@officers == []}>
            <td colspan="6" class="px-5 py-8 text-center text-muted">
              No directors recorded yet.
            </td>
          </tr>
        </tbody>
      </table>
    </.card>
  <% else %>
    <.setup_needed />
  <% end %>

  <.modal
    :if={@form}
    id="officer-modal"
    show
    size="lg"
    title={if(@officer, do: "Edit #{@officer.name}", else: "Appoint a director or secretary")}
    on_cancel={JS.patch(~p"/compliance/officers")}
  >
    <.form for={@form} id="officer-form" phx-change="validate" phx-submit="save" class="space-y-4">
      <div class="grid gap-4 sm:grid-cols-2">
        <.input field={@form[:name]} label="Full name" />
        <.input
          field={@form[:role]}
          type="select"
          label="Role"
          options={Enum.map(@roles, &{officer_role_label(&1), &1})}
        />
        <.input field={@form[:nationality]} label="Nationality" />
        <.input field={@form[:id_number]} label="ID / passport no." />
        <.input field={@form[:kra_pin]} label="KRA PIN" />
        <.input field={@form[:date_of_birth]} type="date" label="Date of birth" />
        <.input field={@form[:occupation]} label="Occupation" />
        <.input :if={!@officer} field={@form[:appointed_on]} type="date" label="Appointed on" />
        <.input field={@form[:email]} label="Email" />
        <.input field={@form[:phone]} label="Phone" />
      </div>
      <.input field={@form[:residential_address]} label="Residential address" />
      <.input field={@form[:service_address]} label="Service address (shown on public records)" />
      <div class="flex justify-end">
        <.button type="submit" variant="primary" phx-disable-with="Saving…" id="save-officer">Save</.button>
      </div>
    </.form>
  </.modal>

  <.modal
    :if={@ceasing}
    id="cease-modal"
    show
    title={"#{@ceasing.name} ceases to hold office"}
    on_cancel={JS.patch(~p"/compliance/officers")}
  >
    <form id="cease-form" phx-submit="cease" class="space-y-4">
      <.input
        type="date"
        name="cease[ceased_on]"
        id="cease-date"
        value={Date.utc_today()}
        label="Ceased on"
      />
      <.input
        name="cease[cessation_reason]"
        id="cease-reason"
        value=""
        label="Reason"
        placeholder="Resigned, removed, deceased…"
      />
      <div class="flex justify-end">
        <.button type="submit" variant="danger" id="save-cease">Record cessation</.button>
      </div>
    </form>
  </.modal>
</Layouts.app>
