<Layouts.app
  flash={@flash}
  current_user={@current_user}
  current_organization={@current_organization}
  active={:compliance_meetings}
>
  <.header>
    Meetings &amp; resolutions
    <:subtitle>Notices, agendas, minutes and resolutions of the board and of members.</:subtitle>
    <:actions>
      <.button
        :if={@profile && admin?(assigns)}
        patch={~p"/compliance/meetings?modal=new"}
        variant="primary"
        id="new-meeting"
      >
        <.icon name="hero-plus-micro" /> Meeting
      </.button>
    </:actions>
  </.header>

  <%= if @profile do %>
    <div id="meetings" class="space-y-3">
      <.card :for={meeting <- @meetings} id={"meeting-#{meeting.id}"}>
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <h2 class="flex flex-wrap items-center gap-2 text-sm font-semibold text-ink">
              {meeting.title}
              <.badge>{kind_label(meeting.kind)}</.badge>
              <.badge color={%{planned: :blue, held: :emerald, cancelled: :slate}[meeting.status]}>
                {Format.humanize(meeting.status)}
              </.badge>
            </h2>
            <p class="text-xs text-muted">
              {Format.date(meeting.held_on)}<span :if={meeting.location}> · {meeting.location}</span>
              <span :if={meeting.notice_sent_on}> · notice sent {Format.date(
                meeting.notice_sent_on
              )}</span>
            </p>
          </div>
          <span class="flex gap-3 text-sm">
            <.link
              navigate={~p"/compliance/print/minutes?id=#{meeting.id}"}
              class="text-ink-soft hover:text-ink"
            >Print minutes</.link>
            <.link
              :if={admin?(assigns)}
              patch={~p"/compliance/meetings?modal=edit&id=#{meeting.id}"}
              class="text-ink-soft hover:text-ink"
              id={"edit-meeting-#{meeting.id}"}
            >
              Edit
            </.link>
          </span>
        </div>
        <ol :if={meeting.resolutions != []} class="mt-3 space-y-1 text-sm">
          <li :for={resolution <- meeting.resolutions} class="flex gap-2">
            <.badge color={if(resolution.kind == :special, do: :violet, else: :slate)}>
              {Format.humanize(resolution.kind)}
            </.badge>
            <span class={["text-ink-soft", !resolution.passed? && "line-through"]}>{resolution.text}</span>
          </li>
        </ol>
      </.card>
      <.card :if={@meetings == []}>
        <.empty_state icon="hero-calendar-days" title="No meetings yet">
          Record board meetings, general meetings and written resolutions with their minutes.
        </.empty_state>
      </.card>
    </div>
  <% else %>
    <.setup_needed />
  <% end %>

  <.modal
    :if={@editing?}
    id="meeting-modal"
    show
    size="lg"
    title={if(@meeting, do: "Edit meeting", else: "New meeting")}
    on_cancel={JS.patch(~p"/compliance/meetings")}
  >
    <form id="meeting-form" phx-change="change" phx-submit="save" class="space-y-4">
      <div class="grid gap-4 sm:grid-cols-2">
        <.input
          type="select"
          name="meeting[kind]"
          id="meeting-kind"
          value={@fields["kind"]}
          label="Kind"
          options={@kinds}
        />
        <.input
          name="meeting[title]"
          id="meeting-title"
          value={@fields["title"]}
          label="Title"
          required
        />
        <.input
          type="date"
          name="meeting[held_on]"
          id="meeting-date"
          value={@fields["held_on"]}
          label="Date"
        />
        <.input
          name="meeting[location]"
          id="meeting-location"
          value={@fields["location"]}
          label="Location / online"
        />
        <.input
          type="date"
          name="meeting[notice_sent_on]"
          id="meeting-notice"
          value={@fields["notice_sent_on"]}
          label="Notice sent on"
        />
        <.input
          type="select"
          name="meeting[status]"
          id="meeting-status"
          value={@fields["status"]}
          label="Status"
          options={[{"Planned", "planned"}, {"Held", "held"}, {"Cancelled", "cancelled"}]}
        />
      </div>
      <.input
        type="textarea"
        name="meeting[agenda]"
        id="meeting-agenda"
        value={@fields["agenda"]}
        label="Agenda"
        rows="3"
      />
      <.input
        type="textarea"
        name="meeting[attendees]"
        id="meeting-attendees"
        value={@fields["attendees"]}
        label="Present / apologies"
        rows="2"
      />
      <.input
        type="textarea"
        name="meeting[minutes]"
        id="meeting-minutes"
        value={@fields["minutes"]}
        label="Minutes"
        rows="6"
      />

      <div>
        <p class="mb-2 text-sm font-medium text-ink">Resolutions</p>
        <div
          :for={row <- @resolutions}
          id={"resolution-#{row["key"]}"}
          class="mb-2 grid gap-2 rounded-xl border border-line p-3 sm:grid-cols-[1fr_9rem_6rem_2rem]"
        >
          <.input
            name={"resolutions[#{row["key"]}][text]"}
            id={"resolution-text-#{row["key"]}"}
            value={row["text"]}
            placeholder="That the company…"
          />
          <.input
            type="select"
            name={"resolutions[#{row["key"]}][kind]"}
            id={"resolution-kind-#{row["key"]}"}
            value={row["kind"]}
            options={[{"Ordinary", "ordinary"}, {"Special", "special"}, {"Board", "board"}]}
          />
          <.input
            type="select"
            name={"resolutions[#{row["key"]}][passed?]"}
            id={"resolution-passed-#{row["key"]}"}
            value={row["passed?"]}
            options={[{"Passed", "true"}, {"Not passed", "false"}]}
          />
          <button
            type="button"
            phx-click="remove_resolution"
            phx-value-key={row["key"]}
            class="mb-2 self-end text-muted hover:text-danger"
          >
            <.icon name="hero-trash-micro" />
          </button>
        </div>
        <button
          type="button"
          phx-click="add_resolution"
          id="add-resolution"
          class="inline-flex items-center gap-1 text-sm font-medium text-ink-soft hover:text-ink"
        >
          <.icon name="hero-plus-micro" /> Add resolution
        </button>
      </div>
      <div class="flex justify-end">
        <.button type="submit" variant="primary" id="save-meeting">Save</.button>
      </div>
    </form>
  </.modal>
</Layouts.app>
