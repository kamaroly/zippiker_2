<Layouts.app
  flash={@flash}
  current_user={@current_user}
  current_organization={@current_organization}
  active={:warehouses}
>
  <.header>
    Warehouses
    <:subtitle>
      Where you keep stock. Receipts and deliveries use the default unless you pick one.
    </:subtitle>
    <:actions>
      <.button
        :if={admin?(assigns)}
        patch={~p"/inventory/warehouses/new"}
        variant="primary"
        id="new-warehouse"
      >
        <.icon name="hero-plus-micro" /> Warehouse
      </.button>
    </:actions>
  </.header>

  <.table id="warehouses" rows={@streams.warehouses}>
    <:col :let={{_id, warehouse}} label="Name">
      <span class={["font-medium text-ink", !warehouse.active? && "opacity-50"]}>
        {warehouse.name}
      </span>
      <.badge :if={warehouse.default?} color={:orange} class="ml-2">Default</.badge>
      <.badge :if={!warehouse.active?} class="ml-2">Inactive</.badge>
    </:col>
    <:col :let={{_id, warehouse}} label="Code">
      <span class="font-mono text-xs">{warehouse.code}</span>
    </:col>
    <:col :let={{_id, warehouse}} label="Address" class="hidden md:table-cell">
      <span class="text-ink-soft">{warehouse.address}</span>
    </:col>
    <:action :let={{_id, warehouse}}>
      <.link
        :if={admin?(assigns)}
        patch={~p"/inventory/warehouses/#{warehouse}/edit"}
        class="text-ink-soft hover:text-ink"
      >
        Edit
      </.link>
    </:action>
  </.table>

  <.modal
    :if={@form}
    id="warehouse-modal"
    show
    title={if(@warehouse, do: "Edit #{@warehouse.name}", else: "New warehouse")}
    on_cancel={JS.patch(~p"/inventory/warehouses")}
  >
    <.form
      for={@form}
      id="warehouse-form"
      phx-change="validate"
      phx-submit="save"
      class="space-y-4"
    >
      <div class="grid gap-4 sm:grid-cols-[1fr_140px]">
        <.input
          field={@form[:name]}
          label="Name"
          placeholder="Shop floor"
          phx-mounted={JS.focus()}
        />
        <.input field={@form[:code]} label="Code" placeholder="SHOP" />
      </div>
      <.input field={@form[:address]} type="textarea" label="Address" />
      <.input
        :if={@branch_options != []}
        field={@form[:branch_id]}
        type="select"
        label="Branch"
        options={@branch_options}
      />
      <.input
        field={@form[:default?]}
        type="checkbox"
        label="Default for receipts and deliveries"
      />
      <.input :if={@warehouse} field={@form[:active?]} type="checkbox" label="Active" />
      <div class="flex justify-end">
        <.button type="submit" variant="primary" phx-disable-with="Saving…">Save</.button>
      </div>
    </.form>
  </.modal>
</Layouts.app>
