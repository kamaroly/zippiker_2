<Layouts.app
  flash={@flash}
  current_user={@current_user}
  current_organization={@current_organization}
  active={:boms}
>
  <.header>
    Bills of materials
    <:subtitle>What each product is made of, and how it's made.</:subtitle>
    <:actions>
      <.button
        :if={admin?(assigns)}
        navigate={~p"/manufacturing/boms/new"}
        variant="primary"
        id="new-bom"
      >
        <.icon name="hero-plus-micro" /> Bill of materials
      </.button>
    </:actions>
  </.header>

  <div id="boms" class="grid gap-4 md:grid-cols-2">
    <.card :for={bom <- @boms} id={"bom-#{bom.id}"}>
      <div class="mb-3 flex items-start justify-between gap-3">
        <div class="min-w-0">
          <h2 class="flex items-center gap-2 truncate text-base font-semibold text-ink">
            {bom.product.name}
            <.badge>{bom.reference}</.badge>
            <.badge :if={!bom.active?} color={:rose}>Inactive</.badge>
          </h2>
          <p class="text-xs text-muted">
            Makes {qty(bom.quantity)} {bom.product.unit} · about
            <span class="tabular text-ink">
              {Format.money(Money.new!(@currency, unit_cost(bom)))}
            </span>
            each
          </p>
        </div>
        <span class="flex shrink-0 gap-3 text-sm">
          <.link
            navigate={~p"/manufacturing/orders/new?product_id=#{bom.product_id}"}
            class="text-ink-soft hover:text-ink"
            id={"produce-bom-#{bom.id}"}
          >
            Produce
          </.link>
          <.link
            :if={admin?(assigns)}
            navigate={~p"/manufacturing/boms/#{bom}/edit"}
            class="text-ink-soft hover:text-ink"
          >
            Edit
          </.link>
          <.link
            :if={admin?(assigns)}
            phx-click="delete"
            phx-value-id={bom.id}
            data-confirm="Delete this bill of materials?"
            class="text-danger hover:opacity-80"
          >
            Delete
          </.link>
        </span>
      </div>
      <ul class="space-y-1.5 text-sm">
        <li :for={component <- bom.components} class="flex justify-between gap-3">
          <span class="truncate text-ink-soft">{component.product.name}</span>
          <span class="tabular text-muted">{qty(component.quantity)} {component.product.unit}</span>
        </li>
      </ul>
      <p :if={bom.operations != []} class="mt-3 border-t border-line pt-2 text-xs text-muted">
        <.icon name="hero-cog-6-tooth-micro" />
        {Enum.map_join(bom.operations, " → ", & &1.name)}
      </p>
    </.card>
  </div>
  <.card :if={@boms == []}>
    <.empty_state icon="hero-clipboard-document-list" title="No bills of materials yet">
      Describe what a product is made of (components from stock) and the steps to make it.
    </.empty_state>
  </.card>
</Layouts.app>
