<Layouts.app
  flash={@flash}
  current_user={@current_user}
  current_organization={@current_organization}
  active={:workspace}
>
  <.header>
    Workspace
    <:subtitle>
      Settings shared by everyone in {@current_organization.name}
      <span id="workspace-domain">({@current_organization.domain})</span>.
    </:subtitle>
  </.header>

  <div class="grid gap-4 lg:grid-cols-2">
    <div class="space-y-4">
      <.card title="General">
        <.form
          for={@form}
          id="workspace-form"
          phx-change="validate"
          phx-submit="save"
          class="space-y-4"
        >
          <.input field={@form[:name]} label="Workspace name" disabled={!admin?(assigns)} />
          <.input
            field={@form[:currency]}
            label="Reporting currency"
            disabled
            hint="Fixed once documents exist. Multi-currency arrives with exchange rates."
          />
          <div :if={admin?(assigns)} class="flex justify-end">
            <.button type="submit" variant="primary" phx-disable-with="Saving…">Save</.button>
          </div>
        </.form>
      </.card>

      <.card :if={admin?(assigns)} title="Maker-checker" id="maker-checker">
        <form id="maker-checker-form" phx-submit="save_maker_checker" class="space-y-4">
          <p class="text-sm text-muted">
            Four eyes on sensitive changes: in the areas you tick, a change isn't applied until
            someone else approves it under <.link
              navigate={~p"/approvals/changes"}
              class="underline hover:text-ink"
            >
              Approvals → Change requests
            </.link>.
          </p>
          <label class="flex items-center gap-2 text-sm font-medium text-ink">
            <input type="hidden" name="maker_checker[enabled]" value="false" />
            <input
              type="checkbox"
              name="maker_checker[enabled]"
              value="true"
              id="maker-checker-enabled"
              checked={@current_organization.maker_checker?}
              class="size-4 rounded border-line"
            /> Require a checker's approval for changes
          </label>
          <div class="space-y-1.5 rounded-xl border border-line p-3">
            <input type="hidden" name="maker_checker[scopes][]" value="" />
            <label
              :for={scope <- Zippiker.Workflow.MakerChecker.scopes()}
              class="flex cursor-pointer items-start gap-2.5 rounded-lg px-2 py-1.5 hover:bg-canvas"
            >
              <input
                type="checkbox"
                name="maker_checker[scopes][]"
                value={scope.key}
                id={"maker-checker-scope-#{scope.key}"}
                checked={scope.key in @current_organization.maker_checker_scopes}
                class="mt-0.5 size-4 rounded border-line"
              />
              <span>
                <span class="block text-sm text-ink">{scope.label}</span>
                <span class="block text-xs text-muted">{scope.description}</span>
              </span>
            </label>
          </div>
          <p
            :if={@admin_count < 2}
            class="rounded-lg bg-warning-soft px-3 py-2 text-xs text-warning"
          >
            With only one admin there's nobody else to check changes, so they'd be approved
            straight away. Add another admin, or a checker workflow under Approvals → Workflows.
          </p>
          <div class="flex justify-end">
            <.button
              type="submit"
              variant="primary"
              phx-disable-with="Saving…"
              id="save-maker-checker"
            >
              Save
            </.button>
          </div>
        </form>
      </.card>

      <.card :if={admin?(assigns)} title="Invite people">
        <.form
          for={@invite_form}
          id="invite-form"
          phx-submit="invite"
          class="flex flex-wrap items-start gap-2"
        >
          <div class="min-w-56 flex-1">
            <.input field={@invite_form[:email]} type="email" placeholder="teammate@company.com" />
          </div>
          <div class="w-32">
            <.input
              field={@invite_form[:role]}
              type="select"
              options={[{"Member", "member"}, {"Admin", "admin"}]}
            />
          </div>
          <.button type="submit" variant="primary" phx-disable-with="Sending…">Send invite</.button>
        </.form>

        <ul id="invitations" phx-update="stream" class="mt-4 divide-y divide-line">
          <li id="invitations-empty" class="hidden only:block">
            <p class="text-sm text-muted">No pending invitations.</p>
          </li>
          <li
            :for={{dom_id, invitation} <- @streams.invitations}
            id={dom_id}
            class="flex items-center gap-3 py-2.5"
          >
            <.icon name="hero-envelope" class="size-4 text-muted" />
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm text-ink">{invitation.email}</p>
              <p class="text-xs text-muted">
                {Format.humanize(invitation.role)} · sent {Format.ago(invitation.inserted_at)}
              </p>
            </div>
            <button
              phx-click="revoke"
              phx-value-id={invitation.id}
              class="text-xs font-medium text-danger hover:underline"
            >
              Revoke
            </button>
          </li>
        </ul>
      </.card>
    </div>

    <.card title="Members" padded={false}>
      <ul id="members" phx-update="stream" class="divide-y divide-line px-5 pb-2">
        <li
          :for={{dom_id, membership} <- @streams.members}
          id={dom_id}
          class="flex items-center gap-3 py-3"
        >
          <.avatar name={Format.user_name(membership.user)} size="sm" />
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-medium text-ink">
              {Format.user_name(membership.user)}
            </p>
            <p class="truncate text-xs text-muted">{membership.user.email}</p>
          </div>
          <.link
            :if={can_impersonate?(assigns, membership)}
            href={~p"/workspaces/#{@current_organization.id}/impersonate/#{membership.user_id}"}
            method="post"
            data-confirm={"Sign in as #{Format.user_name(membership.user)}? You'll see exactly what they see until you stop."}
            id={"impersonate-#{membership.user_id}"}
            class="rounded-lg px-2 py-1 text-xs font-medium text-ink-soft ring-1 ring-line transition hover:bg-canvas hover:text-ink"
            title="See the workspace as this person"
          >
            <.icon name="hero-eye-micro" /> Impersonate
          </.link>
          <%= if admin?(assigns) and membership.role != :owner and membership.user_id != @current_user.id do %>
            <form id={"role-#{membership.id}"} phx-change="role">
              <input type="hidden" name="membership_id" value={membership.id} />
              <select
                name="role"
                class="h-8 rounded-lg border border-line bg-surface px-2 text-xs text-ink focus:border-brand focus:outline-none"
              >
                {Phoenix.HTML.Form.options_for_select(
                  [{"Member", "member"}, {"Admin", "admin"}],
                  membership.role
                )}
              </select>
            </form>
            <button
              phx-click="remove"
              phx-value-id={membership.id}
              data-confirm={"Remove #{Format.user_name(membership.user)} from the workspace?"}
              class="rounded p-1 text-muted transition hover:text-danger"
              title="Remove"
            >
              <.icon name="hero-user-minus" class="size-4" />
            </button>
          <% else %>
            <.badge color={if(membership.role == :owner, do: :orange, else: :slate)}>
              {Format.humanize(membership.role)}
            </.badge>
          <% end %>
        </li>
      </ul>
    </.card>
  </div>
</Layouts.app>
