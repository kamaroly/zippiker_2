<div id="landing" class="relative overflow-x-clip bg-canvas text-ink">
  <%!-- Navigation --%>
  <header class="sticky top-0 z-40 border-b border-transparent bg-canvas/70 backdrop-blur-xl">
    <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6">
      <a href="/" class="flex items-center gap-2 font-semibold tracking-tight" id="lp-logo">
        <span class="flex size-8 items-center justify-center rounded-xl bg-brand text-sm font-bold text-white shadow-card">
          Z
        </span>
        <span class="text-lg">zippiker</span>
      </a>
      <div class="hidden items-center gap-7 text-sm text-ink-soft md:flex">
        <a href="#product" class="transition hover:text-ink">Product</a>
        <a href="#ai" class="transition hover:text-ink">AI assistant</a>
        <a href="#africa" class="transition hover:text-ink">Built for Africa</a>
        <a href="#pricing" class="transition hover:text-ink">Pricing</a>
        <a href="#faq" class="transition hover:text-ink">FAQ</a>
      </div>
      <div class="flex items-center gap-2">
        <a
          href={~p"/sign-in"}
          class="hidden rounded-lg px-3 py-2 text-sm font-medium text-ink-soft transition hover:text-ink sm:block"
          id="lp-sign-in"
        >
          Sign in
        </a>
        <a
          href={~p"/register"}
          id="lp-nav-cta"
          class="group inline-flex items-center gap-1.5 rounded-full bg-ink px-4 py-2 text-sm font-medium text-canvas shadow-card transition hover:bg-ink/90"
        >
          Start free
          <.icon
            name="hero-arrow-right-micro"
            class="size-4 transition group-hover:translate-x-0.5"
          />
        </a>
      </div>
    </nav>
  </header>

  <%!-- Hero --%>
  <section class="relative isolate">
    <div class="lp-mesh" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto grid max-w-7xl items-center gap-14 px-4 pt-16 pb-24 sm:px-6 lg:grid-cols-[1.05fr_1fr] lg:pt-24">
      <div>
        <a
          href="#ai"
          class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/80 px-3 py-1 text-xs font-medium text-ink-soft shadow-card backdrop-blur transition hover:text-ink"
        >
          <span class="rounded-full bg-brand px-2 py-0.5 text-[10px] font-semibold tracking-wide text-white uppercase">New</span>
          Bring your own AI: Claude, ChatGPT, Grok or Gemini
          <.icon name="hero-chevron-right-micro" class="size-3.5" />
        </a>
        <h1 class="mt-6 text-5xl leading-[1.04] font-semibold tracking-tight text-balance sm:text-6xl lg:text-7xl">
          Your whole business. <span class="lp-gradient-text">One system.</span>
          An AI that does the busywork.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft">
          Zippiker is the ERP for growing companies: CRM, sales, purchasing, stock, accounting,
          HR and company secretarial, connected from first quote to final payment. Ask it
          anything about your business and let it prepare the paperwork.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href={~p"/register"}
            id="lp-hero-cta"
            class="group inline-flex items-center gap-2 rounded-full bg-brand px-6 py-3.5 text-base font-semibold text-white shadow-[0_10px_30px_-10px_rgb(255_105_45/0.8)] transition hover:-translate-y-0.5 hover:shadow-[0_16px_40px_-12px_rgb(255_105_45/0.9)]"
          >
            Start your free trial
            <.icon name="hero-arrow-right" class="size-5 transition group-hover:translate-x-0.5" />
          </a>
          <a
            href="#product"
            class="inline-flex items-center gap-2 rounded-full px-5 py-3.5 text-base font-medium text-ink transition hover:bg-surface/70"
          >
            <.icon name="hero-play-circle" class="size-5 text-brand" /> See how it works
          </a>
        </div>
        <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted">
          <li class="flex items-center gap-1.5">
            <.icon name="hero-check-micro" class="size-4 text-success" /> No credit card
          </li>
          <li class="flex items-center gap-1.5">
            <.icon name="hero-check-micro" class="size-4 text-success" /> Set up in minutes
          </li>
          <li class="flex items-center gap-1.5">
            <.icon name="hero-check-micro" class="size-4 text-success" /> Cancel anytime
          </li>
        </ul>
      </div>

      <%!-- Product mock --%>
      <div class="relative" aria-hidden="true">
        <div class="lp-card-glow relative overflow-hidden rounded-3xl bg-surface">
          <div class="flex items-center gap-1.5 border-b border-line px-4 py-3">
            <span class="size-2.5 rounded-full bg-[#ff5f57]"></span>
            <span class="size-2.5 rounded-full bg-[#febc2e]"></span>
            <span class="size-2.5 rounded-full bg-[#28c840]"></span>
            <span class="ml-3 rounded-md bg-canvas px-3 py-0.5 text-[11px] text-muted">app.zippiker.com/dashboard</span>
          </div>
          <div class="grid gap-3 p-4 sm:grid-cols-3">
            <div
              :for={
                {label, value, delta} <- [
                  {"Cash", "KES 4.82M", "+12%"},
                  {"Owed to you", "KES 1.36M", "18 invoices"},
                  {"Profit this month", "KES 912K", "+8.4%"}
                ]
              }
              class="rounded-2xl border border-line bg-surface-muted p-3"
            >
              <p class="text-[11px] text-muted">{label}</p>
              <p class="mt-1 text-lg font-semibold tracking-tight">{value}</p>
              <p class="text-[11px] font-medium text-success">{delta}</p>
            </div>
            <div class="rounded-2xl border border-line p-3 sm:col-span-3">
              <div class="flex items-end gap-1.5 pt-2" style="height: 96px">
                <span
                  :for={height <- [38, 52, 44, 61, 58, 72, 66, 80, 74, 88, 84, 96]}
                  class="flex-1 rounded-t-md bg-gradient-to-t from-brand/70 to-amber-300/80"
                  style={"height: #{height}%"}
                ></span>
              </div>
              <div class="mt-2 flex justify-between text-[10px] text-muted">
                <span>Jan</span><span>Revenue, last 12 months</span><span>Dec</span>
              </div>
            </div>
          </div>
        </div>

        <div class="lp-float absolute -bottom-10 -left-4 w-72 rounded-2xl border border-line bg-surface p-3 shadow-pop sm:-left-10">
          <p class="flex items-center gap-2 text-xs font-medium text-ink">
            <span class="flex size-6 items-center justify-center rounded-full bg-brand/10 text-brand">
              <.icon name="hero-sparkles-micro" class="size-3.5" />
            </span>
            Who owes us the most?
          </p>
          <p class="mt-2 text-xs leading-relaxed text-ink-soft">
            Globex owes KES 420,000 across 3 invoices; INV-0118 is 34 days overdue. Want me to draft a reminder?
          </p>
          <p class="mt-2 flex items-center gap-1 text-[11px] text-muted">
            <.icon name="hero-chart-bar-micro" class="size-3" />
            Ran the accounts receivable ageing report
          </p>
        </div>

        <div class="lp-float-delayed absolute -top-6 -right-2 w-60 rounded-2xl border border-brand/30 bg-surface p-3 shadow-pop sm:-right-8">
          <p class="text-xs font-semibold text-ink">Approve this?</p>
          <p class="mt-1 text-xs text-ink-soft">
            Create a draft invoice for Globex: 2 lines, KES 180,000
          </p>
          <div class="mt-2 flex gap-1.5">
            <span class="rounded-md bg-brand px-2 py-1 text-[11px] font-medium text-white">Approve</span>
            <span class="rounded-md border border-line px-2 py-1 text-[11px] text-ink-soft">Decline</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%!-- Proof strip --%>
  <section class="border-y border-line bg-surface/60">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-6 px-4 py-10 sm:px-6 md:grid-cols-4">
      <div
        :for={
          {number, label} <- [
            {"12", "connected modules"},
            {"91", "reports, ready to run"},
            {"12", "built-in roles"},
            {"1", "system instead of five"}
          ]
        }
        class="text-center"
      >
        <p class="text-4xl font-semibold tracking-tight">{number}</p>
        <p class="mt-1 text-sm text-muted">{label}</p>
      </div>
    </div>
  </section>

  <%!-- Problem / solution --%>
  <section id="product" class="mx-auto max-w-7xl px-4 py-24 sm:px-6">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold tracking-wide text-brand uppercase">Why Zippiker</p>
      <h2 class="mt-3 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
        Stop stitching your business together with spreadsheets and WhatsApp
      </h2>
      <p class="mt-4 text-lg text-ink-soft">
        When sales, stock and the books live in different places, numbers drift, invoices slip and
        month-end takes a week. Zippiker keeps every team on the same records, so the work flows and
        the books keep themselves.
      </p>
    </div>

    <div class="mt-16 grid gap-6 lg:grid-cols-3">
      <div
        :for={
          {icon, title, old_way, new_way} <- [
            {"hero-arrow-path-rounded-square", "Quote to cash, without retyping",
             "Quotes in Word, orders in Excel, invoices in another app.",
             "Quote → order → delivery note → invoice → payment, one click each. Stock and the ledger update themselves."},
            {"hero-calculator", "Books that keep themselves",
             "An accountant re-entering every sale at month-end.",
             "Double-entry postings from every invoice, bill, payment and stock move. Profit & loss and balance sheet, live."},
            {"hero-shield-check", "Control without bottlenecks",
             "Everyone has the admin password, or nobody can do anything.",
             "Roles like Sales rep or Accountant, maker-checker approvals for sensitive changes, and a full audit log."}
          ]
        }
        class="group rounded-3xl border border-line bg-surface p-7 shadow-card transition hover:-translate-y-1 hover:shadow-pop"
      >
        <span class="flex size-11 items-center justify-center rounded-2xl bg-brand/10 text-brand transition group-hover:scale-110">
          <.icon name={icon} class="size-6" />
        </span>
        <h3 class="mt-5 text-xl font-semibold tracking-tight">{title}</h3>
        <p class="mt-3 flex gap-2 text-sm text-muted line-through decoration-muted/40">
          {old_way}
        </p>
        <p class="mt-2 flex gap-2 text-sm leading-relaxed text-ink-soft">
          <.icon name="hero-check-circle-micro" class="mt-0.5 size-4 shrink-0 text-success" /> {new_way}
        </p>
      </div>
    </div>
  </section>

  <%!-- Modules --%>
  <section class="relative isolate py-24">
    <div class="lp-grid absolute inset-0 -z-10 opacity-60" aria-hidden="true"></div>
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <p class="text-sm font-semibold tracking-wide text-brand uppercase">
            Everything connected
          </p>
          <h2 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">
            Every module you need. Switch on what you use.
          </h2>
        </div>
        <a
          href={~p"/register"}
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-ink hover:text-brand"
        >
          Try them all free <.icon name="hero-arrow-right-micro" class="size-4" />
        </a>
      </div>

      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div
          :for={
            {icon, name, text} <- [
              {"hero-funnel", "CRM",
               "Leads, deal pipeline, tasks and every call and email in one timeline."},
              {"hero-document-text", "Sales",
               "Quotes, orders, delivery notes and invoices your customers can accept online."},
              {"hero-shopping-cart", "Purchasing",
               "RFQs, LPOs, goods received notes and supplier bills, matched automatically."},
              {"hero-archive-box", "Inventory",
               "Stock across warehouses at average cost, reorder alerts and count sheets."},
              {"hero-calculator", "Accounting",
               "Automatic double-entry, journals, chart of accounts and live statements."},
              {"hero-user-group", "People",
               "Employees, leave with approvals and accruals, on/offboarding and timesheets."},
              {"hero-wrench-screwdriver", "Manufacturing",
               "Bills of materials, production orders, job cards and costing."},
              {"hero-building-library", "Company secretarial",
               "Statutory registers, beneficial owners and a filing calendar."},
              {"hero-receipt-percent", "Expenses",
               "Claims with receipts, multi-step approvals and reimbursement."},
              {"hero-chart-bar", "Reports",
               "91 standard reports, from ageing to VAT to the general ledger, with CSV export."},
              {"hero-globe-alt", "Portals",
               "Customers accept quotes and see invoices; suppliers send prices, in their own portal."},
              {"hero-check-badge", "Approvals",
               "Workflows by amount, manager or group, with maker-checker for sensitive data."}
            ]
          }
          class="rounded-2xl border border-line bg-surface/90 p-5 backdrop-blur transition hover:border-brand/40 hover:shadow-card"
        >
          <.icon name={icon} class="size-6 text-brand" />
          <h3 class="mt-3 font-semibold">{name}</h3>
          <p class="mt-1 text-sm leading-relaxed text-muted">{text}</p>
        </div>
      </div>
    </div>
  </section>

  <%!-- AI --%>
  <section id="ai" class="relative isolate overflow-hidden bg-[#121110] py-24 text-white">
    <div
      class="absolute inset-0 -z-10 opacity-70"
      aria-hidden="true"
      style="background: radial-gradient(45% 60% at 85% 10%, rgb(255 105 45 / 0.35), transparent 70%), radial-gradient(40% 50% at 10% 90%, rgb(124 58 237 / 0.3), transparent 70%);"
    >
    </div>
    <div class="mx-auto grid max-w-7xl items-center gap-14 px-4 sm:px-6 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold tracking-wide text-amber-300 uppercase">AI-native</p>
        <h2 class="mt-3 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
          An assistant that knows your business, and asks before it acts
        </h2>
        <p class="mt-4 text-lg text-white/70">
          Ask “how did sales do this month?” and get the answer from your own reports. Say “draft an
          invoice for Globex” and it prepares it. Nothing is saved until you click Approve.
        </p>
        <ul class="mt-8 space-y-4">
          <li
            :for={
              {icon, title, text} <- [
                {"hero-key", "Bring your own AI",
                 "Use your company's Claude, ChatGPT, Grok or Gemini account. Your key, your provider, your bill."},
                {"hero-lock-closed", "Works as you, never more",
                 "It only sees and does what your role allows. Keys are encrypted at rest."},
                {"hero-hand-raised", "You stay in charge",
                 "Every change waits for your approval. It never issues, pays or deletes anything."}
              ]
            }
            class="flex gap-4"
          >
            <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-white/10 text-amber-300">
              <.icon name={icon} class="size-5" />
            </span>
            <div>
              <p class="font-semibold">{title}</p>
              <p class="text-sm text-white/65">{text}</p>
            </div>
          </li>
        </ul>
      </div>

      <div
        class="rounded-3xl border border-white/10 bg-white/5 p-5 shadow-2xl backdrop-blur"
        aria-hidden="true"
      >
        <div class="space-y-3 text-sm">
          <p class="ml-auto w-fit max-w-[80%] rounded-2xl rounded-br-md bg-white px-4 py-2.5 text-[#121110]">
            What's our profit so far this year, and which customers drove it?
          </p>
          <p class="flex items-center gap-1.5 text-xs text-white/50">
            <.icon name="hero-chart-bar-micro" class="size-3.5" /> Ran the profit and loss report
          </p>
          <p class="flex items-center gap-1.5 text-xs text-white/50">
            <.icon name="hero-chart-bar-micro" class="size-3.5" />
            Ran the sales by customer summary
          </p>
          <div class="max-w-[90%] rounded-2xl rounded-tl-md bg-white/10 px-4 py-3 leading-relaxed text-white/90">
            Net income year to date is KES 6.4M on KES 21.8M of sales (29% margin).
            Your top three customers brought in 41% of sales:
            <span class="mt-2 block">- Globex: KES 4.1M</span>
            <span class="block">- Umbrella Ltd: KES 2.9M</span>
            <span class="block">- Initech: KES 1.9M</span>
          </div>
          <div class="ml-6 w-fit rounded-xl border border-amber-300/40 bg-amber-300/10 px-3 py-2 text-xs">
            <span class="font-semibold text-amber-200">Approve?</span>
            <span class="text-white/70">Create task “Send Globex a thank-you and renewal quote”</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%!-- Built for Africa --%>
  <section id="africa" class="mx-auto max-w-7xl px-4 py-24 sm:px-6">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold tracking-wide text-brand uppercase">
          Built where you work
        </p>
        <h2 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">
          Made for how African businesses actually run
        </h2>
        <p class="mt-4 text-lg text-ink-soft">
          Global ERPs make you bend to them. Zippiker starts from mobile money, local tax and local
          company law.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div
          :for={
            {icon, title, text} <- [
              {"hero-device-phone-mobile", "Mobile money built in",
               "Record M-Pesa and other mobile money payments; they post to their own account."},
              {"hero-receipt-percent", "VAT done right",
               "Output and input VAT, exceptions and tax liability reports, per tax rate."},
              {"hero-building-library", "Companies Act ready",
               "Registers of directors, members and beneficial owners, plus your filing calendar."},
              {"hero-currency-dollar", "Your currency",
               "Report in KES, RWF, UGX, TZS, NGN, ZAR, GHS, USD and more; several legal entities and branches."}
            ]
          }
          class="rounded-2xl border border-line bg-surface p-5 shadow-card"
        >
          <.icon name={icon} class="size-6 text-brand" />
          <p class="mt-3 font-semibold">{title}</p>
          <p class="mt-1 text-sm text-muted">{text}</p>
        </div>
      </div>
    </div>
  </section>

  <%!-- How it works --%>
  <section class="border-y border-line bg-surface/60 py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-center text-4xl font-semibold tracking-tight sm:text-5xl">
        Live in an afternoon
      </h2>
      <div class="mt-14 grid gap-8 md:grid-cols-3">
        <div
          :for={
            {step, title, text} <- [
              {"1", "Create your workspace",
               "Sign up, name your company and pick your currency. Your data gets its own private space."},
              {"2", "Bring your team",
               "Invite people and give them roles: sales, accounts, stores, HR. They see only what they need."},
              {"3", "Start selling",
               "Add products, send your first quote, and watch the books, stock and reports fill themselves."}
            ]
          }
          class="relative"
        >
          <span class="flex size-12 items-center justify-center rounded-2xl bg-ink text-lg font-semibold text-canvas">
            {step}
          </span>
          <h3 class="mt-5 text-xl font-semibold">{title}</h3>
          <p class="mt-2 text-ink-soft">{text}</p>
        </div>
      </div>
    </div>
  </section>

  <%!-- Pricing --%>
  <section id="pricing" class="mx-auto max-w-7xl px-4 py-24 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold tracking-wide text-brand uppercase">Pricing</p>
      <h2 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">
        Simple per-user pricing
      </h2>
      <p class="mt-4 text-lg text-ink-soft">
        Start with a free trial. Pay only for the people who use it.
      </p>
    </div>

    <%= if @plans == [] do %>
      <div class="mx-auto mt-12 max-w-md rounded-3xl border border-line bg-surface p-8 text-center shadow-card">
        <p class="text-lg font-semibold">Free trial, every module</p>
        <p class="mt-2 text-sm text-muted">Talk to us about a plan that fits your team.</p>
        <a
          href={~p"/register"}
          class="mt-6 inline-flex rounded-full bg-brand px-6 py-3 font-semibold text-white"
        >Start free</a>
      </div>
    <% else %>
      <div class={[
        "mx-auto mt-14 grid gap-6",
        length(@plans) == 1 && "max-w-md",
        length(@plans) == 2 && "max-w-3xl md:grid-cols-2",
        length(@plans) >= 3 && "md:grid-cols-3"
      ]}>
        <div
          :for={{plan, index} <- Enum.with_index(@plans)}
          id={"plan-#{plan.id}"}
          class={[
            "relative flex flex-col rounded-3xl border bg-surface p-8 shadow-card",
            index == div(length(@plans), 2) && length(@plans) >= 3 &&
              "border-brand ring-4 ring-brand/10",
            !(index == div(length(@plans), 2) && length(@plans) >= 3) && "border-line"
          ]}
        >
          <span
            :if={index == div(length(@plans), 2) and length(@plans) >= 3}
            class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-brand px-3 py-1 text-xs font-semibold text-white"
          >
            Most popular
          </span>
          <h3 class="text-lg font-semibold">{plan.name}</h3>
          <p :if={plan.description} class="mt-1 text-sm text-muted">{plan.description}</p>
          <p class="mt-6 flex items-baseline gap-1">
            <span class="text-4xl font-semibold tracking-tight">{plan_price(plan)}</span>
            <span :if={!Decimal.eq?(plan.price_per_seat, 0)} class="text-sm text-muted">/ user / month</span>
          </p>
          <p
            :if={plan.trial_days && plan.trial_days > 0}
            class="mt-1 text-xs font-medium text-success"
          >
            {plan.trial_days}-day free trial
          </p>
          <ul class="mt-6 flex-1 space-y-2.5 text-sm">
            <li :for={module <- plan.modules || []} class="flex items-center gap-2 text-ink-soft">
              <.icon name="hero-check-micro" class="size-4 text-success" /> {module_name(module)}
            </li>
            <li :if={plan.seat_limit} class="flex items-center gap-2 text-ink-soft">
              <.icon name="hero-check-micro" class="size-4 text-success" />
              Up to {plan.seat_limit} users
            </li>
            <li class="flex items-center gap-2 text-ink-soft">
              <.icon name="hero-check-micro" class="size-4 text-success" />
              AI assistant (bring your own AI)
            </li>
          </ul>
          <a
            href={~p"/register"}
            class={[
              "mt-8 inline-flex justify-center rounded-full px-5 py-3 text-sm font-semibold transition",
              index == div(length(@plans), 2) && length(@plans) >= 3 &&
                "bg-brand text-white hover:bg-brand/90",
              !(index == div(length(@plans), 2) && length(@plans) >= 3) &&
                "bg-ink text-canvas hover:bg-ink/90"
            ]}
          >
            Start free trial
          </a>
        </div>
      </div>
    <% end %>
  </section>

  <%!-- FAQ --%>
  <section id="faq" class="mx-auto max-w-3xl px-4 pb-24 sm:px-6">
    <h2 class="text-center text-4xl font-semibold tracking-tight">Questions, answered</h2>
    <div class="mt-10 divide-y divide-line rounded-3xl border border-line bg-surface shadow-card">
      <details
        :for={
          {question, answer} <- [
            {"How long does it take to get started?",
             "Minutes. Create your workspace, add your products and customers (or import them), and send your first quote the same day. Accounting sets itself up with a standard chart of accounts."},
            {"Do I need an accountant to use it?",
             "No. Zippiker writes the double-entry postings for you from invoices, bills, payments and stock moves. Your accountant gets a clean general ledger, trial balance and statements when they need them."},
            {"Is my data safe?",
             "Every company gets its own private data space. Roles decide who sees and changes what, sensitive changes can require a second approver, and every change is in the audit log."},
            {"Which AI does the assistant use?",
             "Yours. Connect your company's Anthropic Claude, OpenAI ChatGPT, xAI Grok or Google Gemini account in Settings. The assistant only works with your approval."},
            {"Can my customers and suppliers use it?",
             "Yes. Customers can view and accept quotes and see their invoices in their own portal; suppliers can answer requests for quotation and see purchase orders."},
            {"What happens after the trial?",
             "Pick a plan and keep going with everything you've set up. Pay per user per month; no long contracts."}
          ]
        }
        class="group px-6 py-5 [&_summary::-webkit-details-marker]:hidden"
      >
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium">
          {question}
          <.icon
            name="hero-plus"
            class="size-5 shrink-0 text-muted transition group-open:rotate-45"
          />
        </summary>
        <p class="mt-3 text-sm leading-relaxed text-ink-soft">{answer}</p>
      </details>
    </div>
  </section>

  <%!-- Final CTA --%>
  <section class="px-4 pb-24 sm:px-6">
    <div class="relative isolate mx-auto max-w-6xl overflow-hidden rounded-[2rem] bg-ink px-6 py-16 text-center text-canvas sm:px-16">
      <div
        class="absolute inset-0 -z-10 opacity-80"
        aria-hidden="true"
        style="background: radial-gradient(50% 80% at 50% 0%, rgb(255 105 45 / 0.45), transparent 70%);"
      >
      </div>
      <h2 class="mx-auto max-w-3xl text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
        Run your business on one system, starting today
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lg opacity-75">
        Free trial with every module and the AI assistant. No credit card, no setup fee.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href={~p"/register"}
          id="lp-final-cta"
          class="inline-flex items-center gap-2 rounded-full bg-brand px-7 py-3.5 font-semibold text-white transition hover:-translate-y-0.5"
        >
          Create your workspace <.icon name="hero-arrow-right" class="size-5" />
        </a>
        <a
          href={~p"/sign-in"}
          class="inline-flex items-center rounded-full border border-white/20 px-7 py-3.5 font-medium transition hover:bg-white/10"
        >
          Sign in
        </a>
      </div>
    </div>
  </section>

  <%!-- Footer --%>
  <footer class="border-t border-line">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-4 py-10 text-sm text-muted sm:flex-row sm:px-6">
      <p class="flex items-center gap-2">
        <span class="flex size-6 items-center justify-center rounded-lg bg-brand text-xs font-bold text-white">Z</span>
        © {Date.utc_today().year} Zippiker
      </p>
      <nav class="flex flex-wrap justify-center gap-5">
        <a href="#product" class="hover:text-ink">Product</a>
        <a href="#pricing" class="hover:text-ink">Pricing</a>
        <a href="#faq" class="hover:text-ink">FAQ</a>
        <a href={~p"/sign-in"} class="hover:text-ink">Sign in</a>
        <a href={~p"/register"} class="hover:text-ink">Start free</a>
      </nav>
    </div>
  </footer>
</div>
